# Normalizza i fine riga: nel repository sempre LF, così Windows e GitHub
# non producono differenze fantasma su file identici.
* text=auto

# index.html è il file pubblicato: LF anche sul disco, su qualunque sistema.
*.html text eol=lf

# Gli script di shell: LF anche sul disco. Un «\r» in fondo a una riga rompe il comando su
# Linux, e struttura.mjs legge questi file dalla copia di lavoro.
*.sh text eol=lf
